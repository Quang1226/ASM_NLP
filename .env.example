# Local demo only. Set your own values; there are no built-in admin credentials.
DEMO_ADMIN_USERNAME=
DEMO_ADMIN_PASSWORD=
# Optional: defaults to data/demo/demo_store.sqlite and local Vite origins.
DEMO_DB_PATH=
DEMO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to 1 after the pinned encoder is downloaded once.
HF_HUB_OFFLINE=0
